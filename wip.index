<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>monnickendam.ch</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
<div class="container">

    <div class="banner">
      <img src="assets/banner.png" alt="monnickendam.ch">
    </div>

    <div class="block">
        <div class="header">Status</div>
        <div class="body">
          <div class="entry">
            <div class="entry-text">
              <p>monnickendam.ch is under construction.</p>
              <p>I'm rebuilding this site and moving things around.</p>
              <p>Check back soon.</p>
            </div>
          </div>
        </div>
    </div>

    <div class="block">
        <div class="header">Links</div>
        <div class="body">
          <div class="entry">
            <div class="social-container">
              <div class="social-items">
                <p><a href="https://linkedin.com/in/monnickendam" target="_blank" rel="noopener noreferrer">LinkedIn</a></p>
              </div>
              <div class="social-items">
                <p><a href="https://github.com/p-i-c-o" target="_blank" rel="noopener noreferrer">Github</a></p>
              </div>
            </div>
          </div>
        </div>
    </div>

</div>

</body>
</html>
